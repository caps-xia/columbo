<?xml version="1.0" encoding="UTF-8"?><project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.caps</groupId>
  <artifactId>columbo</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <properties>
    <java.version>17</java.version>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <google.adk.version>1.11.0</google.adk.version>
    <tencentcloud-sdk.version>3.2.24</tencentcloud-sdk.version>
    <springdoc.version>3.1.1</springdoc.version>
    <mybatis-plus.version>3.5.17</mybatis-plus.version>
    <sa-token.version>1.46.0</sa-token.version>
    <wrench.version>3.3.0-springframework-4.0</wrench.version>
  </properties>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <!-- Boot 4.x 基线即 JDK 17：Spring Framework 7 + Jackson 3（同时兼容管理 Jackson 2） -->
  </parent>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-lang3</artifactId>
        <version>3.20.0</version>
      </dependency>
      <!-- 会话持久化（MyBatis-Plus Boot 4 线 + HikariCP，ai.agent.session-store.* 配置） -->
      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        <version>${mybatis-plus.version}</version>
      </dependency>
      <!-- MCP Java SDK 2.0 线：Stdio 传输显式使用 Jackson2 映射器（mcp 聚合包默认走 Jackson3） -->
      <dependency>
        <groupId>io.modelcontextprotocol.sdk</groupId>
        <artifactId>mcp-json-jackson2</artifactId>
        <version>2.0.1</version>
      </dependency>
      <!-- MCP SDK 全家族对齐 2.0.1：SA 2.0.1 的 MCP client 自动配置按 2.0.1 编译，
           BOM 传递的 2.0.0 缺 McpSchema$ElicitFormRequest 会导致启动失败 -->
      <dependency>
        <groupId>io.modelcontextprotocol.sdk</groupId>
        <artifactId>mcp</artifactId>
        <version>2.0.1</version>
      </dependency>
      <dependency>
        <groupId>io.modelcontextprotocol.sdk</groupId>
        <artifactId>mcp-core</artifactId>
        <version>2.0.1</version>
      </dependency>
      <dependency>
        <groupId>io.modelcontextprotocol.sdk</groupId>
        <artifactId>mcp-json</artifactId>
        <version>2.0.1</version>
      </dependency>
      <dependency>
        <groupId>io.modelcontextprotocol.sdk</groupId>
        <artifactId>mcp-json-jackson3</artifactId>
        <version>2.0.1</version>
      </dependency>
      <dependency>
        <groupId>io.modelcontextprotocol.sdk</groupId>
        <artifactId>mcp-spring-webflux</artifactId>
        <version>2.0.1</version>
      </dependency>
      <!-- 线性时间正则引擎（RE2）：LLM 提供的检索正则用它编译，杜绝灾难性回溯占死线程（ReDoS） -->
      <dependency>
        <groupId>com.google.re2j</groupId>
        <artifactId>re2j</artifactId>
        <version>1.8</version>
      </dependency>
      <!-- guava：显式对齐 google-adk 自带版本（domain 直接使用 ImmutableList，需显式管理） -->
      <dependency>
        <groupId>com.google.guava</groupId>
        <artifactId>guava</artifactId>
        <version>33.7.1-jre</version>
      </dependency>
      <!-- ADK 核心：裁掉本项目用不到的传递依赖（本项目走 Spring AI + OpenAI 兼容网关，
           不用 Vertex AI / Anthropic / gRPC 通道），产物体积 -90M 左右；
           若将来接入 Vertex/Anthropic，删除对应 exclusion 即可 -->
      <dependency>
        <groupId>com.google.adk</groupId>
        <artifactId>google-adk</artifactId>
        <version>${google.adk.version}</version>
        <exclusions>
          <exclusion>
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java</artifactId>
          </exclusion>
          <exclusion>
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java-core</artifactId>
          </exclusion>
          <exclusion>
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java-vertex</artifactId>
          </exclusion>
          <exclusion>
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java-client-okhttp</artifactId>
          </exclusion>
          <exclusion>
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-aiplatform</artifactId>
          </exclusion>
          <exclusion>
            <groupId>com.google.api.grpc</groupId>
            <artifactId>proto-google-cloud-aiplatform-v1</artifactId>
          </exclusion>
          <exclusion>
            <groupId>com.google.api.grpc</groupId>
            <artifactId>proto-google-cloud-aiplatform-v1beta1</artifactId>
          </exclusion>
          <exclusion>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty-shaded</artifactId>
          </exclusion>
          <exclusion>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-xds</artifactId>
          </exclusion>
          <exclusion>
            <groupId>org.conscrypt</groupId>
            <artifactId>conscrypt-openjdk-uber</artifactId>
          </exclusion>
        </exclusions>
      </dependency>
      <!-- dev 工具（adk web ui / code interpreter）不进运行时产物：google-adk-spring-ai 已 exclusion google-adk-dev -->
      <dependency>
        <groupId>com.google.adk</groupId>
        <artifactId>google-adk-spring-ai</artifactId>
        <version>${google.adk.version}</version>
        <exclusions>
          <exclusion>
            <groupId>com.google.adk</groupId>
            <artifactId>google-adk-dev</artifactId>
          </exclusion>
        </exclusions>
      </dependency>
      <!-- spring ai 2.0.1（GA，Boot 4 / Framework 7 线） https://central.sonatype.com/artifact/org.springframework.ai/spring-ai-bom -->
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>2.0.1</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- 腾讯云 CLS SDK（columbo-infrastructure 网关使用） -->
      <dependency>
        <groupId>com.tencentcloudapi</groupId>
        <artifactId>tencentcloud-sdk-java-cls</artifactId>
        <version>${tencentcloud-sdk.version}</version>
      </dependency>
      <!-- https://github.com/spring-ai-community/spring-ai-agent-utils（0.12.0 对齐 Spring AI 2.0.1） -->
      <dependency>
        <groupId>org.springaicommunity</groupId>
        <artifactId>spring-ai-agent-utils</artifactId>
        <version>0.12.0</version>
      </dependency>
      <!-- 设计模式框架（策略树/责任链，https://github.com/xfg0618/xfg-wrench） -->
      <dependency>
        <groupId>cn.bugstack.wrench</groupId>
        <artifactId>xfg-wrench-starter-design-framework</artifactId>
        <version>${wrench.version}</version>
      </dependency>
      <!-- 接口文档 springdoc-openapi（Swagger UI），https://springdoc.org/ -->
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <!-- 工程模块 -->
      <dependency>
        <groupId>org.caps</groupId>
        <artifactId>columbo-api</artifactId>
        <version>1.0-SNAPSHOT</version>
      </dependency>
      <dependency>
        <groupId>org.caps</groupId>
        <artifactId>columbo-domain</artifactId>
        <version>1.0-SNAPSHOT</version>
      </dependency>
      <dependency>
        <groupId>org.caps</groupId>
        <artifactId>columbo-infrastructure</artifactId>
        <version>1.0-SNAPSHOT</version>
      </dependency>
      <dependency>
        <groupId>org.caps</groupId>
        <artifactId>columbo-types</artifactId>
        <version>1.0-SNAPSHOT</version>
      </dependency>
      <dependency>
        <groupId>org.caps</groupId>
        <artifactId>columbo-trigger</artifactId>
        <version>1.0-SNAPSHOT</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <build>
    <plugins>
      <!-- maven 脚手架 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-archetype-plugin</artifactId>
        <version>3.2.0</version>
        <configuration>
          <outputDirectory>${project.build.directory}/caps-ai-agent-scaffold-archetype</outputDirectory>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <modules>
    <module>columbo-api</module>
    <module>columbo-app</module>
    <module>columbo-domain</module>
    <module>columbo-trigger</module>
    <module>columbo-infrastructure</module>
    <module>columbo-types</module>
  </modules>
</project>

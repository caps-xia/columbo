<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.caps</groupId>
        <artifactId>columbo</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>columbo-infrastructure</artifactId>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- 会话持久化（MyBatis-Plus Boot 4 线 + HikariCP）：默认 H2 文件库（零外部依赖，开箱即持久化），
             换 MySQL url 即切生产档（Mapper 已按方言适配） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- 腾讯云日志服务 CLS SDK（海南环境日志渠道：SearchLog 检索） -->
        <dependency>
            <groupId>com.tencentcloudapi</groupId>
            <artifactId>tencentcloud-sdk-java-cls</artifactId>
        </dependency>

        <!-- Sa-Token 核心（token 持久化 Dao 实现在本模块；版本与 trigger 的 starter 对齐） -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-core</artifactId>
            <version>${sa-token.version}</version>
        </dependency>

        <!-- 系统模块 -->
        <dependency>
            <groupId>org.caps</groupId>
            <artifactId>columbo-domain</artifactId>
        </dependency>

        <!-- 基础设施层单测（JUnit 5，迁自 trace-bot 的端口实现测试） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
